// Per-process resources and software (pinned versions in pixi.toml / pixi.lock).
process {
    errorStrategy = 'retry'
    maxRetries    = 1
    // Put the project pixi environment `bio` first on PATH in every task (STAR, salmon, samtools, sra-tools).
    // The profile `modules` replaces this with the cluster modules.
    beforeScript  = "export PATH=${params.root}/.pixi/envs/bio/bin:\$PATH"

    withName: 'QUANTIFY_RUN' {
        cpus   = 16
        memory = '48 GB'     // STAR loads one ~33 GB index at a time
        time   = '6h'        // ~30 min per run for three references
    }
}
