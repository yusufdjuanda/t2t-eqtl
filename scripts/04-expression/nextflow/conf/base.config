// Per-process resources and software (cluster modules, pinned versions).
process {
    errorStrategy = 'retry'
    maxRetries    = 1

    withName: 'QUANTIFY_RUN' {
        cpus   = 16
        memory = '48 GB'     // STAR loads one ~33 GB index at a time
        time   = '6h'        // ~30 min per run for three references
        module = ['sra-tools/3.4.1', 'star/2.7.11b', 'salmon/1.11.4', 'samtools/1.23.1']
    }
}
