// t2t-eqtl stage 04 (expression) pipeline configuration. Documentation: docs/t2t-eqtl.md section 13A.

params {
    // project root: three levels above this folder (scripts/04-expression/nextflow); override with --root
    root        = new File("${projectDir}/../../..").canonicalPath
    // parent of each task's TMPDIR: $T2T_TMP from config/site.env (exported by scripts/lib/common.sh), else <root>/work/tmp
    tmp         = System.getenv('T2T_TMP') ?: "${new File("${projectDir}/../../..").canonicalPath}/work/tmp"
    input       = null                                  // samplesheet CSV (config/samplesheets/<cohort>.csv)
    batch       = 'all'                                 // a batch number from the samplesheet, or 'all'
    references  = 'chm13v2.0,grch38,grch38-ffx'         // folders in data/star-references/
    ref_dir     = "${params.root}/data/star-references"
    outdir      = "${params.root}/results/04-expression"
    star_prefix = 'star-2.7.11b-oh'                     // index used = <ref>/<star_prefix><read_length - 1>
}

manifest {
    name            = 't2t-eqtl/expression'
    description     = 'Quantify RNA-seq runs on T2T-CHM13v2.0, GRCh38 and patched GRCh38 from the same reads'
    nextflowVersion = '>=25.10.0'
    mainScript      = 'main.nf'
}

includeConfig 'conf/base.config'

profiles {
    // Software. Default: the tools of the project's pixi environment (pixi.toml; run `pixi install --locked` first).
    // Profile `modules`: the cluster modules the published results were produced with (same versions, Karakoram only).
    modules {
        process.beforeScript = ''
        process.module       = ['sra-tools/3.4.1', 'star/2.7.11b', 'salmon/1.11.4', 'samtools/1.23.1']
    }
    slurm {
        process.executor = 'slurm'
        // partition and account from config/site.env (T2T_PARTITION, T2T_ACCOUNT); the Slurm default if unset
        process.queue    = System.getenv('T2T_PARTITION') ?: null
        process.clusterOptions = System.getenv('T2T_ACCOUNT') ? "--account=${System.getenv('T2T_ACCOUNT')}" : null
        executor {
            // project limits: 128 cores, 400 GB in total -> 6 x 16 CPUs x 48 GB
            queueSize       = 6
            submitRateLimit = '10/1min'
            pollInterval    = '1 min'
        }
    }
    test {
        params.input = "${params.root}/config/samplesheets/test-mage-2.csv"
        params.batch = 1
    }
}

trace {
    enabled   = true
    overwrite = true
    fields    = 'task_id,hash,name,tag,status,exit,submit,start,complete,duration,realtime,cpus,%cpu,peak_rss,rss,read_bytes,write_bytes'
}
