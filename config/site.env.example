# Site settings for scripts/lib/common.sh and scripts/submit.sh.
# Copy to config/site.env (not tracked by git) and edit for your machine:
#   cp config/site.env.example config/site.env
# Every variable is optional; the defaults below are used when it is unset.

# Where the large folders live. scripts/00-setup/link-storage.sh links <root>/data, results, logs and work to these.
# Leave unset to keep them as ordinary folders inside the project.
#T2T_DATA_DIR=/path/to/project-storage/t2t-eqtl/data
#T2T_RESULTS_DIR=/path/to/project-storage/t2t-eqtl/results
#T2T_LOGS_DIR=/path/to/project-storage/t2t-eqtl/logs
#T2T_WORK_DIR=/path/to/fast-temporary-space/t2t-eqtl/work

# Large temporary space (FASTQ, STAR temporary files, sorting). Default: <root>/work.
#T2T_SCRATCH=/path/to/fast-temporary-space/t2t-eqtl
# Parent folder of every job's TMPDIR. Default: $T2T_SCRATCH/tmp. Do not use /tmp on a shared cluster node.
#T2T_TMP=/path/to/fast-temporary-space/t2t-eqtl/tmp

# Slurm partitions used by scripts/submit.sh. A script asks for one with a line "# t2t-partition: long".
#T2T_PARTITION=cpu
#T2T_PARTITION_LONG=long
# Slurm account, if your cluster requires one.
#T2T_ACCOUNT=my-project

# Folder of the sibling project t2t-atlas (references, SD map, GM12878 analysis), linked by link-storage.sh into
# data/references and data/external/t2t-atlas-analysis. Leave unset if you download the references yourself.
#T2T_ATLAS_DIR=/path/to/project-storage/t2t-atlas
